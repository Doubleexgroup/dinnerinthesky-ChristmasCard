<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Christmas Gift Card | Dinner in the Sky</title>
<meta name="description" content="Regala una cena sospesa nel cielo: la Christmas Gift Card Dinner in the Sky.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
/* =====================================================================
   COME PERSONALIZZARE
   1) SFONDO: carica nel repository img/gift-card-natale.webp
      (oppure cambia --page-image qui sotto)
   2) TUTTI I TESTI (titoli, paragrafi, pulsante, link, contatti):
      si cambiano nel blocco "TESTI DELLA LANDING" in fondo al file
   ===================================================================== */
:root{
  /* SFONDO DELLA LANDING: percorso dell'immagine (versione senza filigrana) */
  --page-image:url('img/gift-card-natale.webp');
  --logo-height:52px;          /* altezza del logo in alto a sinistra */
  --bg:#0a0305;
  --wine:#3a0a14;
  --wine-2:#5c1222;
  --gold:#e0b765;
  --gold-d:#b98a35;
  --cream:#f7eddc;
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Jost',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font:300 1.1rem/1.75 var(--sans);color:var(--cream);background:var(--bg);overflow-x:hidden}
img{max-width:100%;display:block}
:focus-visible{outline:3px solid var(--gold);outline-offset:4px}
#snow{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:50}
h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.02}
h1 i,h2 i{color:var(--gold);font-weight:500}
.eyebrow{font:500 .78rem var(--sans);letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:20px}

/* ---------- HERO ---------- */
.bg{position:fixed;inset:0;z-index:-1;background:var(--page-image) 62% center/cover no-repeat,var(--bg)}
.hero{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;text-align:center;padding:0 24px 56px;
  background:linear-gradient(180deg,transparent 38%,rgba(10,3,5,.6) 68%,rgba(10,3,5,.92) 100%)}
.hero h1{font-size:clamp(2.3rem,5.4vw,4.6rem);margin-bottom:14px;text-shadow:0 4px 30px rgba(0,0,0,.6)}
.hero p.lead{max-width:30em;margin:0 auto 30px;font-size:clamp(1rem,1.4vw,1.2rem);text-shadow:0 2px 16px rgba(0,0,0,.7)}

.logo{position:absolute;top:28px;left:max(24px,3vw);z-index:5;display:block}
.logo img{height:var(--logo-height);width:auto;filter:drop-shadow(0 2px 12px rgba(0,0,0,.55))}
.logo[hidden]{display:none}

/* UNICO PULSANTE */
.cta{position:relative;display:inline-block;padding:20px 50px;border-radius:999px;color:#2a1604;text-decoration:none;font:500 .88rem var(--sans);letter-spacing:.24em;text-transform:uppercase;background:linear-gradient(115deg,#f3d995,var(--gold) 45%,var(--gold-d));box-shadow:0 0 0 1px rgba(255,255,255,.4) inset,0 16px 44px rgba(224,183,101,.35);overflow:hidden;transition:transform .25s,box-shadow .25s}
.cta::after{content:"";position:absolute;top:0;bottom:0;left:-80px;width:50px;background:linear-gradient(100deg,transparent,rgba(255,255,255,.7),transparent);transform:skewX(-20deg);animation:shine 4s ease-in-out infinite}
@keyframes shine{60%,100%{left:120%}}
.cta:hover{transform:translateY(-3px);box-shadow:0 0 0 1px rgba(255,255,255,.5) inset,0 22px 56px rgba(224,183,101,.55)}


/* ---------- TESTI ---------- */
main{background:rgba(10,3,5,.82);backdrop-filter:blur(8px)}
.intro{max-width:760px;margin:0 auto;padding:120px 28px 70px;text-align:center}
.intro h2{font-size:clamp(2.1rem,4.6vw,3.6rem);margin-bottom:22px}
.intro p{opacity:.88}
.points{max-width:1100px;margin:0 auto;padding:0 28px 130px;display:grid;grid-template-columns:repeat(3,1fr);gap:48px}
.points div{border-top:1px solid var(--gold);padding-top:24px}
.points h3{font-size:1.8rem;margin-bottom:10px}
.points p{font-size:1rem;opacity:.85}

footer{background:#050102;color:rgba(247,237,220,.75);text-align:center;padding:46px 24px;font-size:.92rem;border-top:1px solid rgba(224,183,101,.25)}
footer a{color:var(--gold);text-decoration:none}
.copy{margin-top:12px;font-size:.78rem;opacity:.6}

@media(max-width:820px){
  .hero{padding:70px 20px 80px}
  .bg{background-position:66% center}
  .logo{top:20px}
  :root{--logo-height:40px}
  .points{grid-template-columns:1fr;gap:38px;padding-bottom:80px}
  .intro{padding:80px 26px 50px}
}
@media(prefers-reduced-motion:reduce){#snow{display:none}html{scroll-behavior:auto}.cta::after{animation:none}.cta{transition:none}}
</style>
</head>
<body>
<div class="bg" role="img" aria-label="Christmas Gift Card Dinner in the Sky con tavola sospesa sulla città, regali e lanterna"></div>
<canvas id="snow" aria-hidden="true"></canvas>

<header class="hero">
  <a class="logo" id="logo" hidden><img id="logoImg" alt=""></a>
  <div class="eyebrow" data-t="sopratitolo"></div>
  <h1 data-t="titolo"></h1>
  <p class="lead" data-t="sottotitolo"></p>
  <!-- UNICO PULSANTE (testo e link si cambiano nella sezione TESTI in fondo al file) -->
  <a class="cta" id="bottone"></a>
</header>

<main>
  <section class="intro">
    <h2 data-t="introTitolo"></h2>
    <p data-t="introTesto"></p>
  </section>

  <section class="points">
    <div><h3 data-t="punto1Titolo"></h3><p data-t="punto1Testo"></p></div>
    <div><h3 data-t="punto2Titolo"></h3><p data-t="punto2Testo"></p></div>
    <div><h3 data-t="punto3Titolo"></h3><p data-t="punto3Testo"></p></div>
  </section>
</main>

<footer>
  <p><span data-t="assistenza"></span> <a id="mail"></a> · <a id="tel"></a></p>
  <p class="copy" data-t="copyright"></p>
</footer>

<!-- =====================================================================
     TESTI DELLA LANDING: modifica SOLO qui, tra gli apici.
     Per mettere una parola in oro usa <i>parola</i>.
     ===================================================================== -->
<script>
var TESTI = {
  titoloPagina:  "Christmas Gift Card | Dinner in the Sky",
  descrizioneImmagine: "Christmas Gift Card Dinner in the Sky con tavola sospesa sulla città, regali e lanterna",

  /* LOGO in alto a sinistra: scrivi il percorso del file (es. "img/logo.png").
     Lascia "" per non mostrare nessun logo. L'altezza si cambia con --logo-height nel CSS. */
  logo:          "https://static.wixstatic.com/media/1eee86_4c393fc586cf409a8ed23cc5737a6a14~mv2.png/v1/fill/w_636,h_168,al_c,q_85,enc_avif,quality_auto/Logo%20DITS%20White%201.png",
  logoLink:      "https://www.dinnerinthesky.it",
  logoAlt:       "Dinner in the Sky",

  sopratitolo:   "Dinner in the Sky · Natale",
  titolo:        "Regala una <i>cena nel cielo</i>",
  sottotitolo:   "La Christmas Gift Card per chi merita un'esperienza indimenticabile.",

  bottoneTesto:  "Acquista la Gift Card",
  bottoneLink:   "https://www.dinnerinthesky.it/gift-card",

  introTitolo:   "Il regalo che <i>si ricorda</i> tutta la vita",
  introTesto:    "Scrivi qui un breve paragrafo di presentazione: una cena sospesa sopra la città, le luci delle feste sotto i tuoi ospiti e un Natale che nessun altro regalo può eguagliare.",

  punto1Titolo:  "Scegli il valore",
  punto1Testo:   "Spiega in poche righe come si sceglie l'importo della Gift Card.",
  punto2Titolo:  "Regalala subito",
  punto2Testo:   "Spiega come e quando viene consegnata a chi la riceve.",
  punto3Titolo:  "Vola tra le stelle",
  punto3Testo:   "Spiega come chi la riceve sceglie la sua serata nel cielo.",

  assistenza:    "Assistenza:",
  email:         "supporto@dinnerinthesky.it",
  telefono:      "+39 342 798 2112",
  telefonoLink:  "+393427982112",
  copyright:     "© 2026 DITS ITALIA SRL · P.IVA 04391010404"
};

/* Applica i testi (non modificare) */
(function(){
  document.title=TESTI.titoloPagina;
  document.querySelector('.bg').setAttribute('aria-label',TESTI.descrizioneImmagine);
  document.querySelectorAll('[data-t]').forEach(function(el){el.innerHTML=TESTI[el.dataset.t]||''});
  if(TESTI.logo){var l=document.getElementById('logo'),i=document.getElementById('logoImg');i.src=TESTI.logo;i.alt=TESTI.logoAlt;l.href=TESTI.logoLink||'#';l.hidden=false}
  var b=document.getElementById('bottone');b.textContent=TESTI.bottoneTesto;b.href=TESTI.bottoneLink;
  var m=document.getElementById('mail');m.textContent=TESTI.email;m.href='mailto:'+TESTI.email;
  var t=document.getElementById('tel');t.textContent=TESTI.telefono;t.href='tel:'+TESTI.telefonoLink;
})();
</script>

<script>
/* Neve che cade, si ferma se l'utente preferisce meno animazioni */
(function(){
  if(matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var c=document.getElementById('snow'),x=c.getContext('2d'),W,H,F=[],d=Math.min(devicePixelRatio||1,2);
  function init(){
    W=innerWidth;H=innerHeight;c.width=W*d;c.height=H*d;x.setTransform(d,0,0,d,0,0);F=[];
    for(var i=0,n=W<700?60:130;i<n;i++){var z=Math.random();F.push({x:Math.random()*W,y:Math.random()*H,r:.8+z*3,v:.3+z*1.2,s:Math.random()*6.28,a:.4+z*.5,g:Math.random()>.85})}
  }
  function draw(t){
    x.clearRect(0,0,W,H);
    F.forEach(function(f){
      f.y+=f.v;f.x+=Math.sin(t/1500+f.s)*.35;
      if(f.y>H+6){f.y=-6;f.x=Math.random()*W}
      x.globalAlpha=f.a;x.fillStyle=f.g?'#e0b765':'#fff';x.shadowColor=f.g?'#e0b765':'#fff';x.shadowBlur=f.r*2.2;
      x.beginPath();x.arc(f.x,f.y,f.r,0,6.28);x.fill()
    });
    requestAnimationFrame(draw)
  }
  init();addEventListener('resize',init);requestAnimationFrame(draw);
})();
</script>
</body>
</html>
